def _load_initial_camera_params(init_camchain_yaml):
    if not init_camchain_yaml:
        return {}

    chain = kc.CameraChainParameters(init_camchain_yaml)
    params_by_topic = {}
    for cam_idx in range(chain.numCameras()):
        cam_cfg = chain.getCameraParameters(cam_idx)
        camera_model, intrinsics = cam_cfg.getIntrinsics()
        dist_model, dist_coeffs = cam_cfg.getDistortion()
        resolution = cam_cfg.getResolution()
        topic = cam_cfg.getRosTopic()
        params_by_topic[topic] = {
            "camera_model": camera_model,
            "dist_model": dist_model,
            "intrinsics": intrinsics,
            "dist_coeffs": dist_coeffs,
            "resolution": resolution,
            "cam_idx": cam_idx,
        }
    print("Loaded initial camera parameters for {0} topic(s) from: {1}".format(
        len(params_by_topic), init_camchain_yaml))
    return params_by_topic


def _apply_initial_camera_geometry(cam, topic, model_name, init_entry):
    if model_name not in cameraModelConfigs:
        raise RuntimeError("Unknown camera model: {0}".format(model_name))

    expected_camera_model, expected_dist_model = cameraModelConfigs[model_name]
    if init_entry["camera_model"] != expected_camera_model:
        raise RuntimeError(
            "Initial camchain model mismatch for topic {0}: expected {1}, got {2}".format(
                topic, expected_camera_model, init_entry["camera_model"]))
    if init_entry["dist_model"] != expected_dist_model:
        raise RuntimeError(
            "Initial camchain distortion mismatch for topic {0}: expected {1}, got {2}".format(
                topic, expected_dist_model, init_entry["dist_model"]))

    proj = np.array(init_entry["intrinsics"], dtype=float)
    dist = np.array(init_entry["dist_coeffs"], dtype=float)
    current_proj = cam.geometry.projection().getParameters().flatten()
    current_dist = cam.geometry.projection().distortion().getParameters().flatten()
    if len(proj) != len(current_proj):
        raise RuntimeError(
            "Initial camchain intrinsics length mismatch for topic {0}: expected {1}, got {2}".format(
                topic, len(current_proj), len(proj)))
    if len(dist) != len(current_dist):
        raise RuntimeError(
            "Initial camchain distortion length mismatch for topic {0}: expected {1}, got {2}".format(
                topic, len(current_dist), len(dist)))

    cam.geometry.projection().setParameters(proj)
    cam.geometry.projection().distortion().setParameters(dist)
    cam.isGeometryInitialized = True
    print("\tApplied initial camera parameters from camchain cam{0} ({1})".format(
        init_entry["cam_idx"], topic))


def _stamp_to_ns(stamp):
    try:
        integer_types = (int, long)
    except NameError:
        integer_types = (int,)
    if isinstance(stamp, integer_types):
        return int(stamp)
    if isinstance(stamp, float):
        return int(round(stamp * 1e9))
    for attr in ("to_nsec", "toNSec", "getNSec"):
        fn = getattr(stamp, attr, None)
        if fn is not None:
            return int(fn())
    return int(stamp.toSec() * 1e9)


def _safe_array_to_list(value):
    return np.asarray(value, dtype=float).tolist()


def _dump_observation_db(obsdb, out_json, num_cams):
    payload = {"cams": {}}
    for cam_id in range(0, num_cams):
        cam_rows = []
        for obs in obsdb.getAllObsCam(cam_id):
            try:
                corner_ids = [int(v) for v in obs.getCornersIdx()]
            except Exception:
                corner_ids = []
            try:
                corners_image = _safe_array_to_list(obs.getCornersImageFrame())
            except Exception:
                corners_image = []
            try:
                corners_target = _safe_array_to_list(obs.getCornersTargetFrame())
            except Exception:
                corners_target = []
            cam_rows.append(
                {
                    "timestamp_ns": _stamp_to_ns(obs.time()),
                    "corner_ids": corner_ids,
                    "corners_image_frame": corners_image,
                    "corners_target_frame": corners_target,
                }
            )
        payload["cams"]["cam{0}".format(cam_id)] = cam_rows
    with open(out_json, "w") as f:
        json.dump(payload, f, indent=2)


def _dump_initial_camera_params(cameraList, out_json):
    payload = {"cams": {}}
    for cam_idx, cam in enumerate(cameraList):
        proj = cam.geometry.projection().getParameters().flatten()
        dist = cam.geometry.projection().distortion().getParameters().flatten()
        payload["cams"]["cam{0}".format(cam_idx)] = {
            "projection": [float(v) for v in proj],
            "distortion": [float(v) for v in dist],
        }
    with open(out_json, "w") as f:
        json.dump(payload, f, indent=2)


def _dump_final_inlier_observation_db(calibrator, out_json, num_cams):
    payload = {
        "meta": {
            "num_batches": int(len(calibrator.views)),
        },
        "cams": {},
    }
    for cam_id in range(0, num_cams):
        payload["cams"]["cam{0}".format(cam_id)] = []

    for batch_id, batch in enumerate(calibrator.views):
        observations_by_cam = dict(batch.rig_observations)
        for cam_id in range(0, num_cams):
            obs = observations_by_cam.get(cam_id)
            if obs is None:
                continue
            try:
                corner_ids = [int(v) for v in obs.getCornersIdx()]
            except Exception:
                corner_ids = []
            try:
                corners_image = _safe_array_to_list(obs.getCornersImageFrame())
            except Exception:
                corners_image = []
            try:
                corners_target = _safe_array_to_list(obs.getCornersTargetFrame())
            except Exception:
                corners_target = []
            payload["cams"]["cam{0}".format(cam_id)].append(
                {
                    "batch_id": int(batch_id),
                    "timestamp_ns": _stamp_to_ns(batch.timestamp),
                    "corner_ids": corner_ids,
                    "corners_image_frame": corners_image,
                    "corners_target_frame": corners_target,
                }
            )

    for rows in payload["cams"].values():
        rows.sort(key=lambda row: (int(row.get("timestamp_ns", 0)), int(row.get("batch_id", 0))))

    with open(out_json, "w") as f:
        json.dump(payload, f, indent=2)


def _initialize_camera_geometry(cam, observations, topic, model_name, parsed, initial_camera_params):
    init_entry = initial_camera_params.get(topic)
    if parsed.skipIntrinsicsInit:
        if init_entry is None:
            raise RuntimeError(
                "--skip-intrinsics-init requires a matching topic in --init-camchain-yaml for {0}".format(
                    topic))
        _apply_initial_camera_geometry(cam, topic, model_name, init_entry)
        return True

    ok = cam.initGeometryFromObservations(observations)
    if not ok:
        return False
    if init_entry is not None:
        print("\t[INFO] Initial camchain found for {0}; overriding the built-in intrinsic init "
              "before batch optimization.".format(topic))
        _apply_initial_camera_geometry(cam, topic, model_name, init_entry)
    return True


def _per_camera_arg(values, cam_id):
    if values is None:
        return None
    if len(values) == 1:
        return values[0]
    return values[cam_id]


def _extract_intrinsics_observations(cam, topic, cam_id, parsed):
    intrinsics_bag = _per_camera_arg(parsed.intrinsicsBags, cam_id)
    if intrinsics_bag is None:
        return None

    intrinsics_det = _per_camera_arg(parsed.intrinsicsPrecomputedDetections, cam_id)
    print("\tIntrinsic initialization dataset override:")
    print("\t  Bag:              {0}".format(intrinsics_bag))
    if intrinsics_det is not None:
        print("\t  Precomputed dets: {0}".format(intrinsics_det))

    init_dataset = initBagDataset(intrinsics_bag, topic, None, None)
    multithreading = not (parsed.verbose or parsed.showextraction)
    return kc.extractCornersFromDataset(
        init_dataset,
        cam.ctarget.detector,
        multithreading=multithreading,
        clearImages=False,
        noTransformation=True,
        precomputed_detections_file=intrinsics_det,
        conf_thr=parsed.fisheyeConfThr,
        min_corners=parsed.fisheyeMinCorners,
    )



def _read_csv_dicts(path):
    import csv
    with open(path, 'r') as f:
        return list(csv.DictReader(f))


def _safe_float_role(row, key, default=0.0):
    try:
        return float(row.get(key, default))
    except Exception:
        return default


def _role_schedule_from_csvs(timestamps, groups_csv, roles_csv, prefix_per_camera, no_shuffle):
    """Return timestamp feed order: easy/anchor/center prefix, mono+covisible next, final random remainder.

    This preserves Kalibr's normal online estimator but avoids starting PnP/incremental
    calibration on mono/covisible-only observations.  It is intentionally local to the
    calibration loop; final BA/outlier filtering still sees every accepted batch.
    """
    if not groups_csv or not roles_csv:
        out = list(timestamps)
        if not no_shuffle:
            random.shuffle(out)
        return out
    try:
        group_rows = _read_csv_dicts(groups_csv)
        role_rows = _read_csv_dicts(roles_csv)
    except Exception as e:
        sm.logWarn("Failed to read staged role CSVs; falling back to default timestamp order: {0}".format(repr(e)))
        out = list(timestamps)
        if not no_shuffle:
            random.shuffle(out)
        return out

    # Kalibr's ObsDb stores timestamps as seconds (float), while DataWash CSVs
    # store ROS timestamps in nanoseconds.  Match in ns for robust lookup, but
    # always return the original ObsDb timestamp objects to avoid KeyError in
    # getAllObsAtTimestamp().
    available_by_ns = {}
    for t in timestamps:
        try:
            available_by_ns[int(round(float(t) * 1e9))] = t
        except Exception:
            pass
    available_ns = set(available_by_ns.keys())
    role_map = {}
    for row in role_rows:
        try:
            role_map[(str(row.get('camera_id')), int(row.get('frame_id')))] = row
        except Exception:
            pass

    def row_active(row):
        return [x for x in str(row.get('active_cams', '')).split(';') if x]

    def row_ts(row):
        return int(row.get('timestamp_ns'))

    def row_role(row):
        fid = int(row.get('frame_id'))
        roles = set(str(role_map.get((cid, fid), {}).get('role', '')) for cid in row_active(row))
        if 'projective_easy' in roles:
            return 'projective_easy'
        if 'anchor' in roles:
            return 'anchor'
        if 'center_area' in roles:
            return 'center_area'
        if 'mono_fill' in roles:
            return 'mono_fill'
        if 'covisible' in roles:
            return 'covisible'
        return 'unknown'

    def row_score(row):
        fid = int(row.get('frame_id'))
        rs = [role_map.get((cid, fid), {}) for cid in row_active(row)]
        iso = min([_safe_float_role(r, 'projective_jacobian_isotropy') for r in rs] or [0.0])
        center = max([_safe_float_role(r, 'center_area_fraction') for r in rs] or [0.0])
        span = max([_safe_float_role(r, 'radial_span') for r in rs] or [0.0])
        tags = min([int(float(r.get('valid_tags', 0) or 0)) for r in rs] or [0])
        return (iso, center, span, tags)

    candidate_rows = []
    for row in group_rows:
        try:
            if row_ts(row) in available_ns:
                candidate_rows.append(row)
        except Exception:
            pass

    prefix_target = max(0, int(prefix_per_camera or 0))
    prefix = []
    used = set()
    per_cam = {}
    for cid in ('CAM_A', 'CAM_B'):
        per_cam[cid] = 0

    def add_prefix(row, force=False):
        ts = row_ts(row)
        if ts in used:
            return False
        active = row_active(row)
        if not active:
            return False
        if (not force) and all(per_cam.get(cid, 0) >= prefix_target for cid in active):
            return False
        prefix.append(row)
        used.add(ts)
        for cid in active:
            per_cam[cid] = per_cam.get(cid, 0) + 1
        return True

    easy_items = [r for r in candidate_rows if row_role(r) == 'projective_easy']
    anchor_items = [r for r in candidate_rows if row_role(r) == 'anchor']
    center_items = [r for r in candidate_rows if row_role(r) == 'center_area']
    for items in (easy_items, anchor_items, center_items):
        items.sort(key=lambda r: (-row_score(r)[0], -row_score(r)[1], -row_score(r)[2], -row_score(r)[3], int(r.get('frame_id')), str(r.get('active_cams'))))

    # Always expose every explicit easy frame first.  These are rare in hard
    # 180deg cases and should not be skipped just because one camera already
    # reached its prefix quota.
    for row in easy_items:
        add_prefix(row, force=True)

    # Interleave anchor frames by camera rather than sorting globally by
    # isotropy.  A global sort can feed many CAM_B-only anchors before CAM_A
    # anchors; mixed early batches are more stable for incremental init.
    anchor_by_cam = {}
    for row in anchor_items:
        for cid in row_active(row):
            anchor_by_cam.setdefault(cid, []).append(row)
    for cid in anchor_by_cam:
        anchor_by_cam[cid].sort(key=lambda r: (-row_score(r)[0], -row_score(r)[1], -row_score(r)[2], -row_score(r)[3], int(r.get('frame_id'))))
    while prefix_target <= 0 or not all(v >= prefix_target for v in per_cam.values()):
        progressed = False
        for cid in sorted(anchor_by_cam.keys()):
            while anchor_by_cam[cid] and row_ts(anchor_by_cam[cid][0]) in used:
                anchor_by_cam[cid].pop(0)
            if not anchor_by_cam[cid]:
                continue
            if prefix_target > 0 and per_cam.get(cid, 0) >= prefix_target:
                continue
            progressed = add_prefix(anchor_by_cam[cid].pop(0)) or progressed
        if not progressed:
            break

    for row in center_items:
        if prefix_target > 0 and all(v >= prefix_target for v in per_cam.values()):
            break
        add_prefix(row)

    mono_covis = [r for r in candidate_rows if row_ts(r) not in used and row_role(r) in ('mono_fill', 'covisible')]
    remainder = [r for r in candidate_rows if row_ts(r) not in used and row_role(r) not in ('mono_fill', 'covisible')]
    if not no_shuffle:
        random.shuffle(mono_covis)
        random.shuffle(remainder)
    else:
        # Fixed staged mode should still feed the best-conditioned observations
        # first inside each stage; original timestamp order can immediately add
        # weak mono frames after the anchor prefix and destabilize the online
        # estimator.
        mono_covis.sort(key=lambda r: (-row_score(r)[0], -row_score(r)[1], -row_score(r)[2], -row_score(r)[3], int(r.get('frame_id')), str(r.get('active_cams'))))
        remainder.sort(key=lambda r: (-row_score(r)[0], -row_score(r)[1], -row_score(r)[2], -row_score(r)[3], int(r.get('frame_id')), str(r.get('active_cams'))))
    ordered_ns = [row_ts(r) for r in prefix] + [row_ts(r) for r in mono_covis] + [row_ts(r) for r in remainder]
    ordered = [available_by_ns[ns] for ns in ordered_ns if ns in available_by_ns]
    ordered_ns_set = set(ordered_ns)
    missing = [t for t in timestamps if int(round(float(t) * 1e9)) not in ordered_ns_set]
    if not no_shuffle:
        random.shuffle(missing)
    ordered += missing
    sm.logInfo("Staged role schedule: prefix={0} per_cam={1}, mono_covis={2}, remainder={3}, missing={4}".format(
        len(prefix), per_cam, len(mono_covis), len(remainder), len(missing)))
    return ordered


def _staged_prefix_set(timestamps, groups_csv, roles_csv, prefix_per_camera):
    """Return the timestamp subset used for online initialization only."""
    if not groups_csv or not roles_csv:
        return set()
    ordered = _role_schedule_from_csvs(timestamps, groups_csv, roles_csv, prefix_per_camera, True)
    prefix_count = max(0, int(prefix_per_camera or 0)) * 2
    return set(ordered[:prefix_count])

def main():
    parsed = parseArgs()
    initial_camera_params = _load_initial_camera_params(parsed.initCamchainYaml)
    
    #logging modes
    if parsed.verbose:
        sm.setLoggingLevel(sm.LoggingLevel.Debug)
    else:
        sm.setLoggingLevel(sm.LoggingLevel.Info)

    #register signal handler
    signal.signal(signal.SIGINT, signal_exit)

    targetConfig = kc.CalibrationTargetParameters(parsed.targetYaml)

    #create camera objects, initialize the intrinsics and extract targets
    cameraList = list()
    numCams = len(parsed.topics)

    obsdb = kcc.ObservationDatabase(parsed.max_delta_approxsync)
        
    intrinsicsObservationsByCam = {}

    for cam_id in range(0, numCams):
        topic = parsed.topics[cam_id]
        modelName = parsed.models[cam_id]
        print("Initializing cam{0}:".format(cam_id))
        print("\tCamera model:\t  {0}".format(modelName))

        if modelName in cameraModels:
            #open dataset 
            dataset = initBagDataset(parsed.bagfile, topic, parsed.bag_from_to, parsed.bag_freq)
        
            #create camera
            cameraModel = cameraModels[modelName]
            cam = kcc.CameraGeometry(cameraModel, targetConfig, dataset, verbose=(parsed.verbose or parsed.showextraction))
                
            #extract the targets
            multithreading = not (parsed.verbose or parsed.showextraction)
            observations = kc.extractCornersFromDataset(cam.dataset, cam.ctarget.detector, 
                                                        multithreading=multithreading, clearImages=False,
                                                        noTransformation=True,
                                                        precomputed_detections_file=parsed.precomputedDetections,
                                                        conf_thr=parsed.fisheyeConfThr,
                                                        min_corners=parsed.fisheyeMinCorners)
            
            #populate the database
            for obs in observations:
                obsdb.addObservation(cam_id, obs)

            #initialize the intrinsics
            intrinsic_observations = _extract_intrinsics_observations(cam, topic, cam_id, parsed)
            if intrinsic_observations is None:
                intrinsic_observations = observations
            else:
                print("\tUsing {0} intrinsic-only observations for camera initialization; "
                      "using {1} main observations for the multicam graph.".format(
                          len(intrinsic_observations), len(observations)))
            intrinsicsObservationsByCam[cam_id] = intrinsic_observations

            if not _initialize_camera_geometry(cam, intrinsic_observations, topic, modelName, parsed, initial_camera_params):
                raise RuntimeError("Could not initialize the intrinsics for camera with topic: {0}. Try to use --verbose and check whether the calibration target extraction is successful.".format(topic))
            
            print("\tProjection initialized to: %s" % cam.geometry.projection().getParameters().flatten())
            print("\tDistortion initialized to: %s" % cam.geometry.projection().distortion().getParameters().flatten())
            
            cameraList.append(cam)
        else:
            raise RuntimeError( "Unknown camera model: {0}. Try {1}.".format(modelName, list(cameraModels.keys())) )

    if parsed.verbose:
        obsdb.printTable()
    if parsed.dumpObservationDbJson:
        _dump_observation_db(obsdb, parsed.dumpObservationDbJson, numCams)
    
    #initialize the calibration graph
    graph = kcc.MulticamCalibrationGraph(obsdb)
    
    if not graph.isGraphConnected():
        obsdb.printTable()
        print("Cameras are not connected through mutual observations, please check the dataset. Maybe adjust the approx. sync. tolerance.")
        graph.plotGraph()
        sys.exit(-1)
       
    #loop to restart the optimization
    restartAttempts=3
    initOutlierRejection=True
    removedOutlierCorners=list() 
    while True:
        try:
            stage1DumpWritten = False
            #compute initial guesses for the baselines, intrinsics
            print("initializing initial guesses")
            if len(cameraList)>1:
                baseline_guesses = graph.getInitialGuesses(cameraList, fixIntrinsics=parsed.fixIntrinsics)
            else:
                baseline_guesses=[]
                
            if parsed.verbose and len(cameraList)>1:
                graph.plotGraph()

            for baseline_idx, baseline in enumerate(baseline_guesses):
                print("initialized baseline between cam{0} and cam{1} to:".format(baseline_idx, baseline_idx+1))
                print(baseline.T())
                
            for cam_idx, cam in enumerate(cameraList):
                print("initialized cam{0} to:".format(cam_idx))
                print("\t projection cam{0}: {1}".format(cam_idx, cam.geometry.projection().getParameters().flatten()))
                print("\t distortion cam{0}: {1}".format(cam_idx, cam.geometry.projection().distortion().getParameters().flatten()))
            if parsed.dumpInitialCameraJson:
                _dump_initial_camera_params(cameraList, parsed.dumpInitialCameraJson)
                

            print("initializing calibrator")
            if parsed.fixIntrinsics:
                print("Fixing camera projection/distortion parameters during baseline and batch optimization.")
            calibrator = kcc.CameraCalibration(cameraList, baseline_guesses, verbose=parsed.verbose, useBlakeZissermanMest=parsed.doBlakeZisserman, fixIntrinsics=parsed.fixIntrinsics)
            options = calibrator.estimator.getOptions()
            options.infoGainDelta = parsed.miTol
            options.checkValidity = True
            options.verbose = parsed.verbose
            linearSolverOptions = calibrator.estimator.getLinearSolverOptions()
            linearSolverOptions.columnScaling = True
            linearSolverOptions.verbose = parsed.verbose
            linearSolverOptions.epsSVD = 1e-6
            #linearSolverOptions.svdTol = 0.0 #TODO
            #linearSolverOptions.qrTol = 0.0
            
            optimizerOptions = calibrator.estimator.getOptimizerOptions()
            optimizerOptions.maxIterations = parsed.optimizerMaxIterations
            optimizerOptions.nThreads = int(os.environ.get("KALIBR_NTHREADS", max(1, multiprocessing.cpu_count()-1)))
            optimizerOptions.verbose = parsed.verbose
            verbose = parsed.verbose
        
            doPlot = parsed.plot
            if doPlot:
                sm.logWarn("Plotting during calibration. Things may be very slow (but you might learn something).")

            # Schedule the online view feed.  Default behavior is Kalibr's normal
            # random shuffle.  With staged role CSVs, initialization sees easy/anchor
            # observations first, then mono/covisible, while final BA still uses all
            # accepted batches.
            timestamps = obsdb.getAllViewTimestamps()
            timestamps = _role_schedule_from_csvs(
                timestamps,
                parsed.stagedRoleGroupsCsv,
                parsed.stagedRoleRolesCsv,
                parsed.stagedRolePrefixPerCamera,
                parsed.noShuffle,
            )
            init_only_prefix = set()
            if parsed.stagedRoleInitOnly and parsed.stagedRoleGroupsCsv and parsed.stagedRoleRolesCsv:
                init_only_prefix = _staged_prefix_set(
                    timestamps,
                    parsed.stagedRoleGroupsCsv,
                    parsed.stagedRoleRolesCsv,
                    parsed.stagedRolePrefixPerCamera,
                )
                prefix_list = [t for t in timestamps if t in init_only_prefix]
                non_prefix_list = [t for t in timestamps if t not in init_only_prefix]
                timestamps = prefix_list + non_prefix_list
                sm.logInfo("Staged role init-only mode: online_init={0}, final_force={1}".format(
                    len(prefix_list), len(non_prefix_list)))

            onlineTrace = []
            def _write_online_trace(final=False):
                if not parsed.dumpOnlineTraceJson:
                    return
                try:
                    trace_dir = os.path.dirname(parsed.dumpOnlineTraceJson)
                    if trace_dir and not os.path.isdir(trace_dir):
                        os.makedirs(trace_dir)
                    with open(parsed.dumpOnlineTraceJson, 'w') as f:
                        json.dump({
                            "bag": parsed.bagfile,
                            "num_views_total": int(numViews),
                            "max_calibration_views": int(parsed.maxCalibrationViews or 0),
                            "num_entries": int(len(onlineTrace)),
                            "num_batches_current": int(calibrator.estimator.getNumBatches()),
                            "final": bool(final),
                            "entries": onlineTrace,
                        }, f, indent=2, allow_nan=True)
                except Exception as e:
                    sm.logWarn("Failed writing online trace json {0}: {1}".format(parsed.dumpOnlineTraceJson, repr(e)))

            def _online_reprojection_stats(problem):
                vals = []
                per_cam = {}
                try:
                    for cidx, rerrs in problem.rerrs.items():
                        cam_vals = []
                        for rerr in rerrs:
                            if rerr is None:
                                continue
                            try:
                                err = np.asarray(rerr.getMeasurement() - rerr.getPredictedMeasurement(), dtype=float).reshape(-1)
                                if err.size >= 2 and np.all(np.isfinite(err[:2])):
                                    e = float(np.linalg.norm(err[:2]))
                                    vals.append(e)
                                    cam_vals.append(e)
                            except Exception:
                                pass
                        if len(cam_vals) > 0:
                            arrc = np.asarray(cam_vals, dtype=float)
                            per_cam[str(cidx)] = {
                                "num_points": int(arrc.size),
                                "rmse_px": float(np.sqrt(np.mean(arrc * arrc))),
                                "median_px": float(np.median(arrc)),
                                "p90_px": float(np.percentile(arrc, 90)),
                                "tail2_frac": float(np.mean(arrc > 2.0)),
                                "tail5_frac": float(np.mean(arrc > 5.0)),
                                "tail10_frac": float(np.mean(arrc > 10.0)),
                            }
                except Exception as e:
                    return {"error": repr(e)}
                if len(vals) == 0:
                    return {"num_points": 0}
                arr = np.asarray(vals, dtype=float)
                return {
                    "num_points": int(arr.size),
                    "rmse_px": float(np.sqrt(np.mean(arr * arr))),
                    "median_px": float(np.median(arr)),
                    "p90_px": float(np.percentile(arr, 90)),
                    "tail2_frac": float(np.mean(arr > 2.0)),
                    "tail5_frac": float(np.mean(arr > 5.0)),
                    "tail10_frac": float(np.mean(arr > 10.0)),
                    "per_cam": per_cam,
                }

            #process all target views
            print("starting calibration...")
            numViews = len(timestamps)
            progress = sm.Progress2(numViews); progress.sample()
            for view_id, timestamp in enumerate(timestamps):
                final_force_phase = bool(parsed.stagedRoleInitOnly and timestamp not in init_only_prefix)
                if final_force_phase:
                    optimizerOptions.maxIterations = max(int(optimizerOptions.maxIterations), int(parsed.stagedRoleFinalMaxIterations))
                
                #add new batch problem
                obs_tuple = obsdb.getAllObsAtTimestamp(timestamp)    
                est_baselines = list()
                for bidx, baseline in enumerate(calibrator.baselines):
                    est_baselines.append( sm.Transformation(baseline.T()) )
                T_tc_guess = graph.getTargetPoseGuess(timestamp, cameraList, est_baselines)
                               
                num_batches_before = calibrator.estimator.getNumBatches()
                trace_entry = None
                success = calibrator.addTargetView(
                    timestamp,
                    obs_tuple,
                    T_tc_guess,
                    force=final_force_phase,
                    allowDiverged=final_force_phase,
                )
                if parsed.dumpOnlineTraceJson:
                    num_batches_after = calibrator.estimator.getNumBatches()
                    try:
                        trace_ts_ns = int(round(float(timestamp) * 1e9))
                    except Exception:
                        trace_ts_ns = int(timestamp)
                    trace_entry = {
                        "view_id": int(view_id),
                        "timestamp": float(timestamp),
                        "timestamp_ns": trace_ts_ns,
                        "target_pose_guess_available": bool(T_tc_guess is not None),
                        "accepted": bool(success),
                        "num_batches_before": int(num_batches_before),
                        "num_batches_after": int(num_batches_after),
                    }
                    try:
                        if success and len(calibrator.views) > 0:
                            trace_entry["batch_index"] = int(num_batches_after - 1)
                            trace_entry["batch_reprojection"] = _online_reprojection_stats(calibrator.views[-1])
                        elif T_tc_guess is None:
                            trace_entry["reject_reason"] = "missing_target_pose_guess"
                        else:
                            trace_entry["reject_reason"] = "estimator_rejected_batch"
                    except Exception as e:
                        trace_entry["trace_error"] = repr(e)
                    onlineTrace.append(trace_entry)
                    _write_online_trace(final=False)
                
                #display process
                if (verbose or (view_id % 25) == 0) and calibrator.estimator.getNumBatches()>0 and view_id>1:
                    print("")
                    print("------------------------------------------------------------------")
                    print("")
                    print("Processed {0} of {1} views with {2} views used".format(view_id+1, numViews, calibrator.estimator.getNumBatches()))
                    print("")
                    kcc.printParameters(calibrator)
                    print("")
                    print("------------------------------------------------------------------")
                    
                #calibration progress
                progress.sample()
                if parsed.maxCalibrationViews and (view_id + 1) >= parsed.maxCalibrationViews:
                    sm.logWarn("Stopping calibration loop after {0} views due to --max-calibration-views".format(parsed.maxCalibrationViews))
                    break
                
                #plot added views
                if success and doPlot:
                    recent_view = calibrator.views[-1]
                    cams_in_view = [obs_tuple[0] for obs_tuple in recent_view.rig_observations]
                    plotter = PlotCollection.PlotCollection("Added view (stamp: {0})".format(timestamp))
                    for cam_id in cams_in_view:
                        fig=pl.figure(view_id*5000+cam_id)
                        kcc.plotAllReprojectionErrors(calibrator, cam_id, fno=fig.number, noShow=True)                        
                        plotter.add_figure("cam{0}".format(cam_id), fig)
                    plotter.show()
                
                # Look for outliers
                runEndFiltering = view_id==(len(timestamps)-1) and parsed.allowEndFiltering # run another filtering step at the end (over all batches)
                numActiveBatches = calibrator.estimator.getNumBatches()
                if ((success and numActiveBatches>parsed.minViewOutlier*numCams) or (runEndFiltering and numActiveBatches>parsed.minViewOutlier*numCams)) and parsed.removeOutliers: 
                    #create the list of the batches to check               
                    if initOutlierRejection:
                        #check all views after the min. number of batches has been reached
                        batches_to_check=list(range(0, calibrator.estimator.getNumBatches()))
                        print("");print("")
                        print("Filtering outliers in all batches...")
                        initOutlierRejection=False
                        progress_filter = sm.Progress2(len(batches_to_check)); progress_filter.sample()
                    elif runEndFiltering:
                        #check all batches again after all views have been processed
                        if parsed.dumpStage1ObservationDbJson and not stage1DumpWritten:
                            _dump_final_inlier_observation_db(calibrator, parsed.dumpStage1ObservationDbJson, numCams)
                            stage1DumpWritten = True
                        print("");print("")
                        print("All views have been processed.\n\nStarting final outlier filtering...")
                        batches_to_check=list(range(0, calibrator.estimator.getNumBatches()))
                        progress_filter = sm.Progress2(len(batches_to_check)); progress_filter.sample()
                    else:
                        #only check most recent view
                        batches_to_check = [ calibrator.estimator.getNumBatches()-1 ]
                    
                    #now check all the specified batches
                    batches_to_check.sort()
                    batches_to_check.reverse()
                    for batch_id in batches_to_check:
                        
                        #check all cameras in this batch
                        cornerRemovalList_allCams=list()
                        camerasInBatch = list(calibrator.views[batch_id].rerrs.keys())
                        for cidx in camerasInBatch:
                            
                            #calculate the reprojection errors statistics
                            corners, reprojs, rerrs = kcc.getReprojectionErrors(calibrator, cidx)        
                            me, se = kcc.getReprojectionErrorStatistics(rerrs)
                            se_threshold = 4.0*se #TODO: find good value 

                            #select corners to remove
                            cornerRemovalList=list()
                            for pidx, reproj in enumerate(rerrs[batch_id]):
                                if (not np.all(reproj==np.array([None,None]))) and (abs(reproj[0]) > se_threshold[0] or abs(reproj[1]) > se_threshold[1]):
                                    cornerRemovalList.append(pidx)
                                    
                                    #display the corners info
                                    if parsed.verbose or parsed.doPlotOutliers:
                                        sm.logInfo( "Outlier detected on view {4} with idx {5} (rerr=({0}, {1}) > ({2},{3}) )".format(reproj[0], reproj[1], se_threshold[0], se_threshold[1], view_id, pidx))
                                        sm.logInfo( "Predicted: {0}".format(calibrator.views[batch_id].rerrs[cidx][pidx].getPredictedMeasurement()) )
                                        sm.logInfo( "Measured: {0}".format(calibrator.views[batch_id].rerrs[cidx][pidx].getMeasurement()) )

                                    #store the outlier corners for plotting
                                    removedOutlierCorners.append( (cidx, calibrator.views[batch_id].rerrs[cidx][pidx].getMeasurement()) )
                            
                            #queue corners on this cam for removal
                            cornerRemovalList_allCams.append( (cidx, cornerRemovalList) )
                            
                            #plot the observation with the outliers
                            if len(cornerRemovalList)>0 and parsed.doPlotOutliers:                                
                                for cam_id, obs in calibrator.views[batch_id].rig_observations:
                                    if cam_id==cidx:
                                        gridobs = obs
                                fig=pl.figure(view_id*100+batch_id+cidx)                                
                                kcc.plotCornersAndReprojection(gridobs, reprojs[batch_id], cornerlist=cornerRemovalList, 
                                                               fno=fig.number, clearFigure=True, plotImage=True,
                                                               title="Removing outliers in view {0} on cam {0}".format(view_id, cidx))
                                pl.show()
    
                        #remove the corners (if there are corners to be removed)
                        removeCount = sum([len(removelist) for cidx, removelist in cornerRemovalList_allCams])
                        if removeCount>0:
                            original_batch = calibrator.views[batch_id]
                            new_batch = kcc.removeCornersFromBatch(original_batch, cornerRemovalList_allCams, useBlakeZissermanMest=parsed.doBlakeZisserman)
                            
                            #replace the original batch with the corrected
                            calibrator.estimator.removeBatch( calibrator.views[batch_id] )
                            calibrator.views[batch_id] = new_batch
                            rval = calibrator.estimator.addBatch( new_batch, False )
                            
                            #queue the batch for removal if the corrected batch was rejected
                            if not rval.batchAccepted:
                                sm.logDebug("corrected view rejected! removing from optimization...")
                                calibrator.views.remove( calibrator.views[batch_id] )
                            sm.logDebug("Removed {0} outlier corners on batch {1}".format(removeCount, batch_id))   
                        
                        #start and end filtering progress bar
                        if len(batches_to_check)>1:
                            progress_filter.sample()
                            
            # Final full-batch BA. The online initializer sees a staged stream
            # (easy/anchor first, mono/covisible later), but before reporting we
            # re-optimize the complete accepted batch set so the final solution is
            # not biased by the staged insertion order.
            try:
                print("")
                print("Running final full-batch reoptimization...")
                final_rval = calibrator.estimator.reoptimize()
                if getattr(final_rval, "linearSolverFailure", False):
                    sm.logWarn("Final full-batch reoptimization reported a linear solver failure.")
                if getattr(final_rval, "numIterations", 0) >= optimizerOptions.maxIterations:
                    sm.logWarn("Final full-batch reoptimization reached maxIterations.")
            except Exception as e:
                sm.logWarn("Final full-batch reoptimization failed: {0}".format(repr(e)))

            #final output
            print("")
            print("")
            print("..................................................................")
            print("")
            print("Calibration complete.")
            print("")
            if parsed.removeOutliers:
                sm.logWarn("Removed {0} outlier corners.".format(len(removedOutlierCorners)) )             
            print("")
            print("Processed {0} images with {1} images used".format(numViews, calibrator.estimator.getNumBatches()))
            kcc.printParameters(calibrator)
            print("")
            if parsed.dumpStage1ObservationDbJson and not stage1DumpWritten:
                _dump_final_inlier_observation_db(calibrator, parsed.dumpStage1ObservationDbJson, numCams)
                stage1DumpWritten = True
            if parsed.dumpFinalInlierObservationDbJson:
                _dump_final_inlier_observation_db(calibrator, parsed.dumpFinalInlierObservationDbJson, numCams)
            if parsed.dumpOnlineTraceJson:
                _write_online_trace(final=True)
            
            if parsed.verbose and len(calibrator.baselines)>1:
                f=pl.figure(100006)
                kcc.plotCameraRig(calibrator.baselines, fno=f.number, clearFigure=False)
                pl.show()
            
            #write to file
            bagtag = os.path.splitext(parsed.bagfile)[0]
            resultFile = bagtag + "-camchain.yaml"
            kcc.saveChainParametersYaml(calibrator, resultFile, graph)
            print("Results written to:")
            print("  Saving camera chain calibration to file: {0}".format(resultFile))
            
            #save results to file
            resultFileTxt = bagtag + "-results-cam.txt"
            kcc.saveResultTxt(calibrator, filename=resultFileTxt)
            print("  Detailed results written to file: {0}".format(resultFileTxt))
            
            #generate report
            print("")
            print("Generating result report...")
            reportFile = bagtag + "-report-cam.pdf"
            if parsed.skipReportGeneration:
                print("  Skipping report generation (--skip-report-generation)")
            else:
                G=None;
                if numCams>1:
                    G=graph
                kcc.generateReport(calibrator, reportFile, showOnScreen=not parsed.dontShowReport, graph=G, removedOutlierCorners=removedOutlierCorners);
                print("  Report written to {0}".format(reportFile))
            print("")
            
            #generate trajectory file
            if parsed.exportPoses:
                print("Exporting poses...")
                posesFile = bagtag + "-poses-cam0.csv"
                kcc.exportPoses(calibrator, filename=posesFile)
                print("  Poses written to {0}".format(posesFile))
                print("")

        except kcc.OptimizationDiverged:
            restartAttempts-=1
            sm.logWarn("Optimization diverged possibly due to a bad initialization. (Do the models fit the lenses well?)")
            
            if restartAttempts==0:
                sm.logError("Max. attemps reached... Giving up...")
                break
            else:
                sm.logWarn("Restarting for a new attempt...")    
                
                #reinitialize the intrinsics
                for cam_id, cam in enumerate(cameraList):
                    topic = parsed.topics[cam_id]
                    modelName = parsed.models[cam_id]
                    print("Reinitialize the intrinsics for camera {0}".format(cam_id))
                    observations = intrinsicsObservationsByCam.get(cam_id)
                    if observations is None:
                        observations = obsdb.getAllObsCam(cam_id)
                    if not _initialize_camera_geometry(cam, observations, topic, modelName, parsed, initial_camera_params):
                        raise RuntimeError("Could not re-initialize the intrinsics for camera with topic: {0}".format(topic))
                    
                    print("\tProjection initialized to: %s" % cam.geometry.projection().getParameters().flatten())
                    print("\tDistortion initialized to: %s" % cam.geometry.projection().distortion().getParameters().flatten())
                
        else:
            break #normal exit

